<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only. Adds sample recipes for manual testing:
            adb shell am broadcast -n com.nicoapps.cooktime/.debug.SampleRecipesReceiver
            Exported so adb can reach it, but guarded by DUMP, a permission only the shell
            and the system hold.
        -->
        <receiver
            android:name="com.nicoapps.cooktime.debug.SampleRecipesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
